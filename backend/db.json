    {
      "restaurant": "e09cb061f119eb2a51df8e99",
      "title": "Customizing QR code templates",
      "description": "How do I add our custom logo in the center of the QR code image? The option is greyed out.",
      "category": "QR Code",
      "status": "In Progress",
      "priority": "Medium",
      "messages": [
        {
          "sender": "Restaurant",
          "text": "Please activate custom QR design.",
          "createdAt": "2026-06-01T10:40:28.866Z"
        },
        {
          "sender": "SuperAdmin",
          "text": "Hi Giovanni, custom QR design is exclusive to the Enterprise Plan. We see you are on Enterprise, so it should be active. Let us check.",
          "createdAt": "2026-06-02T10:40:28.866Z"
        }
      ],
      "_id": "b29daa3d6a25e9a4a6002928",
      "id": "b29daa3d6a25e9a4a6002928",
